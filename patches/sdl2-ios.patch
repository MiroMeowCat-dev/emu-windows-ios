+// SnowRunner host: use scene coordinates rather than legacy status-bar orientation.
+UIWindowScene *UIKit_ActiveScene(UIScreen *screen)
+{
+    for (UIScene *scene in UIApplication.sharedApplication.connectedScenes) {
+        if ([scene isKindOfClass:UIWindowScene.class] &&
+            scene.activationState == UISceneActivationStateForegroundActive &&
+            ((UIWindowScene *)scene).screen == screen) return (UIWindowScene *)scene;
+    }
+    return nil;
+}
+
+CGRect UIKit_SceneBounds(UIScreen *screen)
+{
+    UIWindowScene *scene = UIKit_ActiveScene(screen);
+    return scene ? scene.coordinateSpace.bounds : screen.bounds;
+}
