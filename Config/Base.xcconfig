// Shared build settings. Personal values are generated from config.local.json.
PRODUCT_NAME = SnowRunner
PRODUCT_BUNDLE_IDENTIFIER = local.emu.snowrunner
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic
CODE_SIGN_ENTITLEMENTS = app/Host/Memory.entitlements
INFOPLIST_FILE = app/Host/Info.plist
GENERATE_INFOPLIST_FILE = NO
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos
IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1,2
ARCHS = arm64
CLANG_ENABLE_OBJC_ARC = YES
CLANG_ENABLE_MODULES = YES
FRAMEWORK_SEARCH_PATHS = $(inherited) "$(SRCROOT)/build/Vendor"
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
ENABLE_USER_SCRIPT_SANDBOXING = YES
#include? "Local.xcconfig"
